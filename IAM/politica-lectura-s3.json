{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketLaboratorio",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::actividad3-seguro-2024"
    },
    {
      "Sid": "LeerObjetosLaboratorio",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::actividad3-seguro-2024/*"
    }
  ]
}